{
  "name": "orgstack",
  "version": "1.0.0",
  "private": true,
  "description": "Orgstack monorepo",
  "scripts": {
    "start:auth": "npm --prefix services/auth-service run start:dev",
    "start:inventory": "npm --prefix services/inventory-service run start:dev",
    "start:order": "npm --prefix services/order-service run start:dev",
    "start:notification": "npm --prefix services/notification-service run start:dev",
    "start:client": "npm --prefix client run dev",
    "build:auth": "npm --prefix services/auth-service run build",
    "build:inventory": "npm --prefix services/inventory-service run build",
    "build:order": "npm --prefix services/order-service run build",
    "build:notification": "npm --prefix services/notification-service run build",
    "build:client": "npm --prefix client run build",
    "install:all": "npm --prefix services/auth-service install && npm --prefix services/inventory-service install && npm --prefix services/order-service install && npm --prefix services/notification-service install && npm --prefix client install"
  }
}
